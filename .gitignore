# Allowlist: ignore everything at the root, then re-include project paths.
/*
!/.gitignore
!/README.md
!/LICENSE
!/pyproject.toml
!/uv.lock
!/install.ps1
!/src/
!/tests/
!/skills/
/skills/*
!/skills/office-search/
# eval output holds words from the documents it was run on; only the shipped prompts are kept
/skills/office-search/evals/*.json
!/skills/office-search/evals/evals.json

# Never commit these, wherever they appear inside allowed paths.
__pycache__/
*.py[cod]
*.egg-info/
.env
.env.*
*.pem
*.key
*.pfx
id_rsa*
id_ed25519*
secrets.*
credentials.*
api_key*
*.token
token.txt
token.json
*_token.txt
*_token.json
